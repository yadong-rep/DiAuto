<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#2A2522" />
            <stroke
                android:width="2dp"
                android:color="#66D9B46A" />
            <padding
                android:bottom="12dp"
                android:left="12dp"
                android:right="12dp"
                android:top="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:centerColor="@color/hongqi_brand_red"
                android:endColor="#6D070D"
                android:startColor="#F0C46A" />
            <stroke
                android:width="2dp"
                android:color="@color/hongqi_brand_gold" />
            <padding
                android:bottom="12dp"
                android:left="12dp"
                android:right="12dp"
                android:top="12dp" />
        </shape>
    </item>
</selector>
