<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hongqi_bg_app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- 上方留白 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <!-- Logo区域 -->
        <TextView
            android:id="@+id/hongqi_activation_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="红旗飞屏"
            android:textColor="@color/hongqi_title"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="设备激活"
            android:textColor="@color/hongqi_subtitle"
            android:textSize="18sp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/hongqi_brand_gold_soft" />

        <!-- 激活码显示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/hongqi_bg_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="激活码"
                android:textColor="@color/hongqi_section_title"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hongqi_activation_text_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="----"
                android:textColor="@color/hongqi_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 状态文字 -->
        <TextView
            android:id="@+id/hongqi_activation_text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="正在验证激活状态..."
            android:textColor="@color/hongqi_brand_gold"
            android:textSize="15sp" />

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/hongqi_activation_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/hongqi_brand_gold" />

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hongqi_activation_btn_refresh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/hongqi_bg_primary_button"
                android:text="刷新状态"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/hongqi_activation_btn_contact"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/hongqi_bg_outline_button"
                android:text="联系我"
                android:textColor="@color/hongqi_brand_gold"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="激活码根据设备信息生成，请提供给管理员激活"
            android:textColor="@color/hongqi_muted_text"
            android:textSize="12sp" />

        <!-- 下方留白 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

    </LinearLayout>

</FrameLayout>
